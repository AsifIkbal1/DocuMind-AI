# DocuMind AI - Environment Configuration Example

# Application Environment
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL default; automatically falls back to SQLite if Postgres unreachable)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/documind_db
# For SQLite local fallback:
# DATABASE_URL=sqlite:///./storage/documind.db

# Vector / Embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Background Processing & Queues (Redis default; fallback in-process worker supported)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# AI Provider Configuration (gemini or openai)
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=gemini-2.0-flash

# Storage & File Uploads
STORAGE_DIR=./storage
UPLOAD_DIR=./storage/uploads
PROCESSED_DIR=./storage/processed
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,tiff,xlsx,xls,csv

# Security & Authentication
JWT_SECRET=documind-super-secure-jwt-secret-key-2026-financial-ai
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Validation Engine Settings
ROUNDING_TOLERANCE=0.05
STRICT_LINE_ITEM_CHECK=True
